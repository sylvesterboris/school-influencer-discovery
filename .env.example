# Copy to .env for local runs. On Streamlit Cloud, put the same keys in App settings → Secrets.
SERPER_API_KEY=your-serper-key          # https://serper.dev (2,500 free queries)
GROQ_API_KEY=your-groq-key              # https://console.groq.com (free tier)

# Optional
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FALLBACK_MODEL=llama-3.1-8b-instant
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
SEARCH_COUNTRY=in
# DB_PATH=data/discovery.db
